# Frontend Environment Variables
# In local development: defaults to http://localhost:5000/api
# In unified single-service Render deployment: leave unset (automatically defaults to relative /api)
# In separate frontend/backend Render deployment: set to your backend service URL (e.g. https://hustlekit-backend.onrender.com/api)
# VITE_API_URL=https://hustlekit-backend.onrender.com/api
VITE_APP_ENV=production
