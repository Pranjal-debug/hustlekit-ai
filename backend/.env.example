# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Gemma Model Provider Configuration (OpenAI-compatible)
# Recommended providers: OpenRouter (https://openrouter.ai), Groq (https://groq.com), or local Ollama
GEMMA_API_KEY=
GEMMA_API_BASE_URL=https://openrouter.ai/api/v1
GEMMA_MODEL=google/gemma-3-12b-it

# Execution Controls
# Set to 'false' to enforce real inference (returns clear error when key is missing)
# Set to 'true' to explicitly permit offline heuristic templates
ENABLE_MOCK_FALLBACK=false

# Timeouts & Limits
GEMMA_TIMEOUT_MS=15000
GEMMA_MAX_TOKENS=800

# MongoDB Atlas Integration
# Set your connection URI and target database name
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=hustlekit_ai
